{
  "name": "@starfleet-technology/lcars-webcomponents",
  "version": "0.0.1",
  "description": "",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=@starfleet-technology/lcars*",
    "release": "pnpm build:packages && changeset publish",
    "changeset": "changeset",
    "changeset:add": "changeset add",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "clean": "turbo run clean",
    "clean:node_modules": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "clean:dist": "find packages -name 'dist' -type d -prune -exec rm -rf '{}' +",
    "clean:turbo": "find . -name '.turbo' -type d -prune -exec rm -rf '{}' +"
  },
  "keywords": [],
