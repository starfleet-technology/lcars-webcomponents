{
  "name": "@starfleet-technology/lcars-vue",
  "version": "0.0.3",
  "description": "Vue bindings for Star Trek LCARS UI components - seamless integration of LCARS design system with Vue.js applications",
  "keywords": [
    "lcars",
    "star-trek",
    "vue",
    "vue-components",
    "web-components",
    "stencil",
    "starfleet-technology",
    "ui-components"
  ],
  "author": "Starfleet Technology <engineering@starfleet.technology> (https://docs.starfleet.technology)",
  "license": "CC BY-NC-SA 4.0",
  "homepage": "https://docs.starfleet.technology",
  "bugs": {
    "url": "https://github.com/starfleet-technology/lcars-webcomponents/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p . --outDir ./dist"
  },
  "publishConfig": {
