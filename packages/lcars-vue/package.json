  },
  "devDependencies": {
    "vue": "^3.5.24",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "@starfleet-technology/config-typescript": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starfleet-technology/lcars-webcomponents.git"
  }
}
