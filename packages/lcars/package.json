{
  "name": "@starfleet-technology/lcars",
  "version": "0.0.3",
  "description": "Star Trek LCARS (Library Computer Access/Retrieval System) UI components built with Stencil for universal web framework compatibility",
  "keywords": [
    "lcars",
    "star-trek",
    "web-components",
    "stencil",
    "starfleet-technology",
    "ui-components",
    "custom-elements"
  ],
  "author": "Starfleet Technology <engineering@starfleet.technology> (https://docs.starfleet.technology)",
  "license": "CC BY-NC-SA 4.0",
  "homepage": "https://docs.starfleet.technology",
  "bugs": {
    "url": "https://github.com/starfleet-technology/lcars-webcomponents/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starfleet-technology/lcars-webcomponents.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/lcars/lcars.esm.js",
  "exports": {
    ".": {
      "import": "./dist/lcars/lcars.esm.js",
      "require": "./dist/lcars/lcars.cjs.js"
    },
    "./dist/*": {
      "import": "./dist/*",
      "types": "./dist/*"
    },
    "./lcars-button": {
      "import": "./dist/components/lcars-button.js",
      "types": "./dist/components/lcars-button.d.ts"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build",
    "dev": "stencil build --watch",
    "preview": "stencil build --dev --watch --serve",
    "test": "stencil test --spec",
    "test:watch": "stencil test --spec --watchAll",
    "generate": "stencil generate"
  },
  "devDependencies": {
    "@stencil/core": "^4.27.1",
    "@stencil/react-output-target": "^1.2.0",
    "@stencil/vue-output-target": "^0.11.8",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.5",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "puppeteer": "^24.3.0",
    "@starfleet-technology/config-typescript": "workspace:*"
  }
}
